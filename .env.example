# Copy to .env for LOCAL real-data fetches. Never commit .env.
# In CI these are provided by GitHub Actions secrets/vars instead.

# A GitHub token. For local use, a fine-grained PAT with read-only
# "Contributions" + "Metadata" access is enough. Public data needs no scopes.
GITHUB_TOKEN=

# Your GitHub username.
GITHUB_USER=

# Optional: comma-separated repo names to become named constellations.
# Leave blank to auto-pick your most active repos.
PROJECT_REPOS=
