{
  "name": "commit-constellation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A nebula-style star map of your GitHub contributions. Each day is a star; brightness is commit count; colours mark languages; your projects form named constellations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test src/lib/arc.test.ts src/lib/color.test.ts src/lib/starfield.test.ts scripts/screenshot.test.mjs",
    "fetch:data": "node scripts/fetch-contributions.mjs",
    "fetch:mock": "node scripts/generate-mock.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "6.0.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=20"
  }
}
