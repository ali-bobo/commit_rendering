{
  "name": "commit-constellation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A nebula-style star map of your GitHub contributions. Each day is a star; brightness is commit count; colours mark languages; your projects form named constellations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fetch:data": "node scripts/fetch-contributions.mjs",
    "fetch:mock": "node scripts/generate-mock.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "5.6.3",
    "vite": "^6.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
